# Local: copy to .env at the repository root; never commit real values.
APP_ENV=development
DATABASE_URL=mysql+pymysql://USER:PERCENT_ENCODED_PASSWORD@TIDB_HOST:4000/vitapick
# Optional if TiDB uses a private CA; otherwise the OS certificate store is used.
TIDB_CA_PATH=
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
DEMO_ACCOUNTS_ENABLED=true
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Issued by data.go.kr for the MFDS food nutrient DB API (FoodNtrCpntDbInfo03).
MFDS_API_KEY=
# One page has up to 500 items; 10 pages import only the first 5,000 source rows.
SYNC_MAX_PAGES=10
# Optional: Google AI Studio key for sentence meal logging; without it the built-in rule parser is used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# OAuth: register BACKEND_URL/api/auth/oauth/{provider}/callback with each provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# Render dashboard (register these variables individually; do NOT upload .env):
# APP_ENV=production, DATABASE_URL, JWT_SECRET, FRONTEND_URL=https://vitapick.onrender.com,
# BACKEND_URL=https://vitapick-api.onrender.com, ADMIN_EMAIL, ADMIN_PASSWORD,
# GEMINI_API_KEY (optional), GOOGLE_CLIENT_ID/SECRET, NAVER_CLIENT_ID/SECRET, KAKAO_CLIENT_ID/SECRET (if used),
# TIDB_CA_PATH (only if a CA file is installed in the container).
# DEMO_ACCOUNTS_ENABLED=true shows the shared one-click test accounts (also in production).
# The demo admin is a read-only 테스트 관리자 (role "viewer"): real members are masked and no role can be changed.
# Netlify: netlify.toml sets public VITE_API_URL=https://vitapick-api.onrender.com;
# if set in the dashboard, use the same URL (dashboard values can override it).
# GitHub Actions secrets for sync: DATABASE_URL, MFDS_API_KEY.
# Optional GitHub Actions variable: SYNC_MAX_PAGES (default 10; raise deliberately for full import).
